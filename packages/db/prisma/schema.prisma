generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
  engineType      = "library"
  output          = "../generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm]
}

model FinanceSnapshot {
  id           String   @id @default(uuid())
  sourceId     String   @unique @map("source_id")
  tabName      String   @map("tab_name")
  period       String?
  rowData      Json     @map("row_data")
  lastSyncedAt DateTime @default(now()) @map("last_synced_at")

  @@index([tabName])
  @@index([period])
  @@map("finance_snapshots")
}

// PHL School Performance Model — "School Rollup" tab only (301 rows, one per
// school). Wide/denormalized by design: one row per school, ~45 columns
// mirroring the sheet, not split into related tables. See
// docs/data-sources/school-rollup-dictionary.md for field-by-field definitions
// and the 6 open questions with the client that some of this depends on.
model SchoolRollup {
  id String @id @default(uuid())

  // ---------- Identity / school metadata ----------
  // NOTE: this column's actual header in the source sheet (index 0) is
  // malformed (" f", a stray artifact) — the sheet has no usable "AUN" header
  // to preserve via @map anyway. The extractor MUST read this column by
  // position (index 0), not by header lookup.
  aun                       String   @map("aun")
  schoolNumber              String   @map("school_number")
  districtName              String   @map("district_name")
  schoolName                String   @map("school_name")
  schoolType                String   @map("school_type") // "District" | "Charter", derived from districtName
  gradeSpan                 String?  @map("grade_span_2025_26") // blank for some cyber charters (open question)
  pctBlackHispanic          Decimal? @db.Decimal(5, 2) @map("pct_black_hispanic_2025_26") // blank for 2 cyber charters; combination method unconfirmed (open question)
  pctLowIncome              Decimal? @db.Decimal(5, 2) @map("pct_low_income_2025_26")
  excludedSelectionCriteria Boolean  @map("excluded_selection_criteria") // never null — always True/False per Read Me

  // ---------- PSSA Reading ----------
  pssaReadingNScored       Int?     @map("pssa_reading_n_scored_2025")
  pssaReadingPctProficient Decimal? @db.Decimal(5, 2) @map("pssa_reading_pct_proficient_2025")
  pssaReadingPredicted     Decimal? @db.Decimal(5, 2) @map("pssa_reading_predicted")
  pssaReadingResidual      Decimal? @db.Decimal(5, 2) @map("pssa_reading_residual")
  pssaReadingBand          String?  @map("pssa_reading_band")

  // ---------- PSSA Math ----------
  pssaMathNScored       Int?     @map("pssa_math_n_scored_2025")
  pssaMathPctProficient Decimal? @db.Decimal(5, 2) @map("pssa_math_pct_proficient_2025")
  pssaMathPredicted     Decimal? @db.Decimal(5, 2) @map("pssa_math_predicted")
  pssaMathResidual      Decimal? @db.Decimal(5, 2) @map("pssa_math_residual")
  pssaMathBand          String?  @map("pssa_math_band")

  // ---------- Keystone Algebra I ----------
  keystoneAlgebraINScored       Int?     @map("keystone_algebra_i_n_scored_2025")
  keystoneAlgebraIPctProficient Decimal? @db.Decimal(5, 2) @map("keystone_algebra_i_pct_proficient_2025")
  keystoneAlgebraIPredicted     Decimal? @db.Decimal(5, 2) @map("keystone_algebra_i_predicted")
  keystoneAlgebraIResidual      Decimal? @db.Decimal(5, 2) @map("keystone_algebra_i_residual")
  keystoneAlgebraIBand          String?  @map("keystone_algebra_i_band")

  // ---------- Keystone Biology ----------
  keystoneBiologyNScored       Int?     @map("keystone_biology_n_scored_2025")
  keystoneBiologyPctProficient Decimal? @db.Decimal(5, 2) @map("keystone_biology_pct_proficient_2025")
  keystoneBiologyPredicted     Decimal? @db.Decimal(5, 2) @map("keystone_biology_predicted")
  keystoneBiologyResidual      Decimal? @db.Decimal(5, 2) @map("keystone_biology_residual")
  keystoneBiologyBand          String?  @map("keystone_biology_band")

  // ---------- Keystone Literature ----------
  keystoneLiteratureNScored       Int?     @map("keystone_literature_n_scored_2025")
  keystoneLiteraturePctProficient Decimal? @db.Decimal(5, 2) @map("keystone_literature_pct_proficient_2025")
  keystoneLiteraturePredicted     Decimal? @db.Decimal(5, 2) @map("keystone_literature_predicted")
  keystoneLiteratureResidual      Decimal? @db.Decimal(5, 2) @map("keystone_literature_residual")
  keystoneLiteratureBand          String?  @map("keystone_literature_band")

  // ---------- Rollup / summary ----------
  simpleAvgResidual             Decimal? @db.Decimal(5, 2) @map("simple_avg_residual")
  enrollmentWeightedAvgResidual Decimal? @db.Decimal(5, 2) @map("enrollment_weighted_avg_residual")
  aboveLineCount                Int      @map("above_line_count")
  within5Count                  Int      @map("within_5_count")
  belowLineCount                Int      @map("below_line_count")
  testsWithData                 Int      @map("tests_with_data")
  currentEnrollment             Int?     @map("current_enrollment_sy_2025_26") // charter-only; blank for 3 unmatched charters (open question)
  authorizedEnrollmentCap       Int?     @map("authorized_enrollment_cap_sy_2025_26") // charter-only
  unusedSeats                   Int?     @map("unused_seats") // charter-only; can be negative
  fillTier                      String?  @map("fill_tier") // charter-only — buckets Unused Seats: Fill-A (100+), Fill-B (50-99), Fill-C (25-49); Expand-A/B for high performers under 25 unused seats
  eapiTier                      String?  @map("eapi_tier") // charter-only, always null for District

  lastSyncedAt DateTime @default(now()) @map("last_synced_at")

  @@unique([aun, schoolNumber])
  @@index([schoolType])
  @@index([districtName])
  @@map("school_rollup")
}

model DocumentChunk {
  id        String                       @id @default(uuid())
  source    String
  sourceId  String                       @map("source_id")
  title     String?
  content   String
  embedding Unsupported("vector(1536)")?
  metadata  Json?
  syncedAt  DateTime                     @default(now()) @map("synced_at")

  @@index([source, sourceId])
  @@map("document_chunks")
}

model UsageLog {
  id                  String   @id @default(uuid())
  toolName            String   @map("tool_name")
  inputJson           Json?    @map("input_json")
  outputJson          Json?    @map("output_json")
  durationMs          Int?     @map("duration_ms")
  error               String?
  calledAt            DateTime @default(now()) @map("called_at")
  anthropicUserId     String?  @map("anthropic_user_id")
  anthropicUserEmail  String?  @map("anthropic_user_email")
  anthropicWorkspace  String?  @map("anthropic_workspace")
  inputTokens         Int?     @map("input_tokens")
  outputTokens        Int?     @map("output_tokens")
  cacheReadTokens     Int?     @map("cache_read_tokens")
  cacheCreationTokens Int?     @map("cache_creation_tokens")
  model               String?

  @@index([toolName])
  @@index([calledAt])
  @@index([anthropicUserId])
  @@index([anthropicUserEmail])
  @@map("usage_logs")
}

model SyncRun {
  id              String    @id @default(uuid())
  connector       String
  status          String
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  recordsUpserted Int       @default(0) @map("records_upserted")
  error           String?
  notes           String?

  @@index([connector, startedAt])
  @@map("sync_runs")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Third-party connector OAuth credentials (access/refresh token + expiry),
// keyed by connector + the connector's own account identifier (e.g. QuickBooks
// realmId). Distinct from `Account` (NextAuth, HQ sign-in) and the MCP OAuth
// tables below (Claude/MCP client access) — this is us authenticating outward
// to a third-party API on behalf of a connector.
model ConnectorCredential {
  id                String   @id @default(uuid())
  connector         String
  externalAccountId String   @map("external_account_id")
  accessToken       String   @map("access_token")
  refreshToken      String   @map("refresh_token")
  expiresAt         DateTime @map("expires_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([connector, externalAccountId])
  @@map("connector_credentials")
}

// ---------- MCP OAuth 2.0 (Phase 23) ----------
//
// The `users` table is the source of truth for MCP access. Anyone who completes
// the OAuth flow ends up with a row here; their `status` + `roles` decide what
// they can do. NextAuth's `Account`/`Session`/`User` tables (above) are
// independent — those gate HQ sign-in only.

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

model McpUser {
  email     String     @id
  status    UserStatus @default(PENDING)
  roles     String[]   @default([])
  createdAt DateTime   @default(now()) @map("created_at")
  lastLogin DateTime?  @map("last_login")

  @@index([status])
  @@map("mcp_users")
}

model OAuthClient {
  clientId       String   @id @map("client_id")
  clientName     String   @map("client_name")
  redirectUris   String[] @map("redirect_uris")
  tokenLifetimeS Int      @default(3600) @map("token_lifetime_s")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("oauth_clients")
}

model OAuthAuthorizationCode {
  code          String    @id
  clientId      String    @map("client_id")
  userEmail     String    @map("user_email")
  redirectUri   String    @map("redirect_uri")
  codeChallenge String    @map("code_challenge")
  scopes        String[]  @default([])
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

model OAuthRefreshToken {
  tokenId   String    @id @map("token_id")
  clientId  String    @map("client_id")
  userEmail String    @map("user_email")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userEmail])
  @@index([expiresAt])
  @@map("oauth_refresh_tokens")
}

// Tool-level ACL, editable from HQ /admin. The MCP server reads this table
// (cached for ~60s) instead of a static TS registry, so admins can change
// who can call what without a code deploy.
model ToolPermission {
  toolName     String   @id @map("tool_name")
  allowedRoles String[] @default([]) @map("allowed_roles")
  category     String   @default("other") // students | donor_finance | search | future | other
  description  String?
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("tool_permissions")
}
